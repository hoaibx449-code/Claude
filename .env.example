# Sao chép tệp này thành .env rồi điền khoá. Không gửi tệp .env cho ai, không đưa lên GitHub.
# Chỉ cần điền dịch vụ bạn dùng; dòng để trống được bỏ qua.

# Giọng đọc EverAI — https://www.everai.vn (mục API trong tài khoản)
EVERAI_API_KEY=
EVERAI_VOICE_CODE=vi_female_thuytrang_mb
EVERAI_MODEL=everai-v1.6

# Tạo ảnh OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Tạo ảnh Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# (Tuỳ chọn) Giọng Google TTS — Google Cloud Console > APIs & Services > Credentials
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=vi-VN-Neural2-A

# (Tuỳ chọn) Giọng ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
