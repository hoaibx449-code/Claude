{
  "name": "net-ve-studio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "render": "node --env-file-if-exists=.env src/cli/render.ts",
    "test": "node --import ./test/text-loader.mjs --test test/*.test.ts",
    "runner": "node --env-file-if-exists=.env src/cli/runner.ts",
    "web:build": "node web/build.mjs",
    "web:dev": "node web/build.mjs && cd web && wrangler dev",
    "web:deploy": "node web/build.mjs && cd web && wrangler deploy",
    "typecheck": "tsc -p web",
    "test:ui": "node tools/check-ui.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.80",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "@tabler/icons": "^3.31.0",
    "esbuild": "^0.25.10",
    "playwright": "1.64.0",
    "typescript": "^5.6.3",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
