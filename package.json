{
  "name": "net-ve-studio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "render": "node --env-file-if-exists=.env src/cli/render.ts",
    "test": "node --test test/*.test.ts",
    "runner": "node --env-file-if-exists=.env src/cli/runner.ts",
    "web:build": "node web/build.mjs",
    "web:dev": "node web/build.mjs && cd web && wrangler dev",
    "web:deploy": "node web/build.mjs && cd web && wrangler deploy",
    "typecheck": "tsc -p web"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.80"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tabler/icons": "^3.31.0",
    "esbuild": "^0.25.10",
    "typescript": "^5.6.3",
    "wrangler": "^4.40.0"
  }
}
